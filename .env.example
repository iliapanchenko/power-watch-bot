# Токен від @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Upstash Redis. Ці дві змінні Vercel додає сам, якщо підключити Upstash
# через Marketplace (там вони називаються KV_REST_API_URL і KV_REST_API_TOKEN —
# код розуміє обидві пари назв).
UPSTASH_REDIS_REST_URL=https://eu1-example-12345.upstash.io
UPSTASH_REDIS_REST_TOKEN=AX...

# Спільний секрет: ним підписані виклики /api/check і /api/setup,
# ним же Telegram підписує вебхук. `openssl rand -hex 24`.
CRON_SECRET=change-me-to-a-long-random-string

# Код-запрошення. Без нього бот нікого не пускає далі /start.
# ПОРОЖНЄ ЗНАЧЕННЯ = бот відкритий для всіх, і будь-хто зможе змусити його
# стукати в довільну адресу з твоєї інфраструктури Vercel.
INVITE_CODE=

# Telegram id власників: не потребують коду, бачать /admin.
# Свій id можна дізнатись у бота командою /id
ADMIN_IDS=

# Скільки адрес дозволено одному чату
MAX_DEVICES_PER_CHAT=3

# Скільки чатів пускати всього
MAX_CHATS=25

# Скільки невдалих перевірок поспіль = «світло зникло»
FAIL_THRESHOLD=2

# Скільки вдалих перевірок поспіль = «світло з'явилось»
OK_THRESHOLD=2

# Таймаут TCP-підключення, мс
PROBE_TIMEOUT=4000

# Пауза між проходами всередині одного виклику /api/check, секунд.
# Cron уміє мінімум раз на хвилину, тому реальну частоту задає саме це.
SWEEP_INTERVAL=15

# Скільки секунд живе один виклик /api/check.
# Має бути меншим за maxDuration у vercel.json (там 60).
MAX_RUN_SECONDS=55

# О котрій за Києвом надсилати підсумок дня
SUMMARY_HOUR=23
SUMMARY_MINUTE=59
