# Токен від @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Рядок підключення до Neon / Vercel Postgres.
# Береться автоматично, якщо інтеграцію підключено через Vercel Marketplace.
DATABASE_URL=postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Спільний секрет: ним підписані виклики /api/check і /api/setup.
# Згенеруй щось довге, напр. `openssl rand -hex 24`.
CRON_SECRET=change-me-to-a-long-random-string

# Telegram user id тих, кому дозволено додавати/видаляти пристрої.
# Кілька — через кому. Порожньо = дозволено будь-кому, хто підписався.
ADMIN_IDS=

# Скільки невдалих перевірок поспіль = «світло зникло»
FAIL_THRESHOLD=2

# Скільки вдалих перевірок поспіль = «світло з'явилось»
OK_THRESHOLD=2

# Таймаут TCP-підключення, мс
PROBE_TIMEOUT=4000

# Пауза між проходами всередині одного виклику /api/check, секунд.
# Cron уміє мінімум раз на хвилину, тому реальну частоту задає саме це.
SWEEP_INTERVAL=15

# Скільки секунд живе один виклик /api/check.
# Має бути меншим за maxDuration у vercel.json (там 60).
MAX_RUN_SECONDS=55
